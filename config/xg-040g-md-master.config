#
# XG-040G-MD —— master-airoha 线（上游 immortalwrt master，内核 6.18）
#
# 设备变体二选一：
#
#   nokia_xg-040g-md-ubi      ← 文件内默认
#       OpenWrt U-Boot 布局，bl2 128K + ubi 255.875 MB，需额外刷
#       preloader.bin / bl31-uboot.fip 换引导；作者魔改的 U-Boot 自带网页救砖。
#
#   nokia_xg-040g-md
#       保留原厂引导与原厂 Nokia 分区表，kernel 写入 nsb_1/kernel，
#       rootfs 寄生在 data 分区（129 MB）。MAC 从原厂 ri 分区直接读取，
#       且保留 nsb_2 备份 bank，可刷回原厂固件。风险最低但空间减半。
#
# CI 编译时变体由 workflow 的 device_variant 输入决定（ubi / stock），
# 会自动改写下面的设备行，因此这里选哪个不影响 Actions 构建结果；
# 只有本地手动 make 时才以这里为准。
##
# Target
#
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
# CONFIG_TARGET_airoha_an7581_DEVICE_nokia_xg-040g-md is not set
CONFIG_TARGET_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y
CONFIG_ARCH_64BIT=y
CONFIG_aarch64=y
CONFIG_LINUX_6_18=y

#
# Airoha hardware
#
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_kmod-i2c-an7581=y
# PON 光口实验（仅 xpon-test 分支的源码里有这个包，master 线上不存在会被忽略）
CONFIG_PACKAGE_kmod-airoha-xpon-en757x=y
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y        # 提供 en7581_npu_rv32.bin（补设备默认只带 MT7996 版的缺口）
CONFIG_PACKAGE_kmod-regulator-userspace-consumer=y

#
# Base system ─ 这是最核心、最小系统必须的
#
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_DEFAULT_base-files=y
CONFIG_DEFAULT_busybox=y                  # 精简版工具集，几乎所有命令都靠它
CONFIG_DEFAULT_ca-bundle=y                # 根证书集合（https/wget/curl 等必须）
CONFIG_DEFAULT_logd=y                     # 系统日志守护进程
CONFIG_DEFAULT_procd=y                    # init 系统 / 服务管理核心
CONFIG_DEFAULT_uci=y                      # 配置系统（/etc/config/*）
CONFIG_DEFAULT_urandom-seed=y             # 随机种子保存/恢复（加密相关）
CONFIG_DEFAULT_urngd=y                    # 用户空间 RNG 守护进程
CONFIG_DEFAULT_netifd=y                   # 网络接口管理核心
CONFIG_DEFAULT_mtd=y                      # Flash 操作工具
CONFIG_DEFAULT_fstools=y                  # 文件系统挂载/检查工具
CONFIG_DEFAULT_block-mount=y              # 块设备挂载支持（USB 盘等）
CONFIG_DEFAULT_libc=y
CONFIG_DEFAULT_libgcc=y
CONFIG_PACKAGE_ca-certificates=y          # 完整证书目录（ca-bundle 之外，某些程序按目录读）
CONFIG_PACKAGE_procd-ujail=y              # 服务沙箱隔离
# 这里不显式声明 uboot-envtools / kmod-ubootenv-nvram：上游 DEFAULT_PACKAGES
# 里有，ubi 与 stock 都装，defconfig 会补齐。
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y

#
# Shell / 常用工具
#
CONFIG_PACKAGE_bash=y                     # 通用 shell，写脚本比 ash 顺手
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_irqbalance=y               # 多核中断均衡，跑满带宽时有用
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_mtr-json=y                 # ping + traceroute 合一，查路由抖动
CONFIG_PACKAGE_bind-dig=y                 # DNS 排查
CONFIG_PACKAGE_lsof=y                     # 查端口被谁占了
CONFIG_PACKAGE_iftop=y                    # 实时看哪个 IP 在跑流量
CONFIG_PACKAGE_stress-ng=y                # CPU / 内存 / IO 压测

#
# Network ─ 基本 IPv4/IPv6 网络栈
#
# dnsmasq-full 与 dnsmasq 互斥；OpenClash 硬依赖 full 版（需要 ipset/nftset 支持）
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_ip-full=y
CONFIG_IPV6=y                             # 全局 IPv6 支持（不是包，是内核选项）
CONFIG_DEFAULT_odhcp6c=y                  # IPv6 DHCP 客户端
CONFIG_DEFAULT_odhcpd-ipv6only=y          # IPv6-only DHCP 服务器（配合 dnsmasq）
CONFIG_PACKAGE_nftables=y                 # nft 核心工具
CONFIG_PACKAGE_firewall4=y                # nftables 版防火墙（取代旧 firewall）
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y         # nft 硬件转发支持（如果芯片支持）
# 下面这组内核模块默认不用，但特意留着：代理软件要用它们，而内核模块事后
# 补不了（kmod 硬绑带哈希的内核版本，官方源那份对不上自建固件）。留着才能
# 让"刷完机 apk add 代理"这条路走得通，整组加起来约 40 KB。
CONFIG_PACKAGE_kmod-nft-tproxy=y          # 透明代理用，passwall / openclash / homeproxy 需要
CONFIG_PACKAGE_kmod-nft-socket=y          # nft socket 匹配，passwall nft 透明代理需要（会带 kmod-nf-socket）
CONFIG_PACKAGE_kmod-nf-socket=y           # nf_socket 查找，kmod-nft-socket 依赖
CONFIG_PACKAGE_kmod-tun=y                 # TUN 设备，sing-box / openclash fake-ip / tun 模式需要
CONFIG_PACKAGE_kmod-inet-diag=y           # ss / 连接诊断；sing-box 硬依赖
CONFIG_PACKAGE_kmod-netlink-diag=y        # netlink 诊断；sing-box 硬依赖
CONFIG_PACKAGE_ethtool-full=y             # ethtool 超集，含速率/双工/自动协商查询
CONFIG_PACKAGE_libustream-openssl=y       # 统一走 openssl，避免 mbedtls/openssl 两套并存
# CONFIG_PACKAGE_libustream-mbedtls is not set

#
# 包管理器：apk
#
CONFIG_PACKAGE_apk=y
CONFIG_DEFAULT_apk-tools=y                # apk 主程序包
CONFIG_PACKAGE_apk-openssl=y              # 与 apk-mbedtls 互斥，按需求改用 openssl 版
# CONFIG_PACKAGE_apk-mbedtls is not set
CONFIG_DEFAULT_openwrt-keyring=y          # 签名验证密钥环（apk 生态常用，且官方镜像默认带）

#
# PPPoE
#
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

#
# SSH
#
CONFIG_PACKAGE_dropbear=y
# dropbear 不提供 SFTP 子系统，而 OpenSSH 9.0 起 scp 默认走 SFTP 协议，
# 于是"scp 文件 root@路由器:/tmp/"会直接失败。补上这个 60 KB 的包，
# scp / sftp / WinSCP / FileZilla 就都能用了。
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_DROPBEAR_SMALL_CODE=y
CONFIG_DROPBEAR_ED25519=y
CONFIG_DROPBEAR_CURVE25519=y

#
# USB
#
CONFIG_USB_SUPPORT=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y # USB 口活动指示灯
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y   # 同上，USB 网卡 / 手机共享网络

#
# Filesystem (extroot)
#
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y            # 上游 DEVICE_PACKAGES 更精简，需显式勾选

#
# LuCI 核心与主题
#
CONFIG_PACKAGE_luci=y                     # Web 管理
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y              # OpenClash 硬依赖（旧版 CBI 兼容层）
CONFIG_PACKAGE_luci-ssl=y                 # LuCI HTTPS 支持
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-bootstrap=y     # 保留 bootstrap 主题作为兜底

#
# LuCI 语言
#
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y     # 需配 luci-app-opkg 本体才生效，见下方说明
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

#
# 代理 / 去广告 / DNS 分流 ─ 默认不带
#
# 这几样很个人化，而且是体积的绝对大头：passwall 带的 sing-box(14.3M) 与
# xray-core(10.4M)、adguardhome(10.9M)、openclash(7.8M)、geoview(2.8M)，
# 五项就占了整个固件的八成。默认不装，需要的人去选包页勾，重编一次即可：
#
#   https://loong1996.github.io/ImmortalWrt-Airoha/packages.html
#
# 要搜的名字（本体和引擎都得选，引擎不会自动跟着来）：
#   luci-app-passwall  xray-core  sing-box  geoview
#   luci-app-openclash  ruby  ruby-yaml
#   luci-app-adguardhome  adguardhome
#   smartdns  luci-app-smartdns
#
# 上面这些全是纯用户态包，选包页上标的是绿色「可后装」——真不想重编的话，
# 刷完机 apk add 也装得上。但内核模块不行，所以前面 Network 节里的
# kmod-nft-tproxy / kmod-nft-socket / kmod-nf-socket / kmod-tun /
# kmod-inet-diag / kmod-netlink-diag 特意留着了。

#
# 其它 LuCI 应用
#
CONFIG_PACKAGE_luci-app-ttyd=y            # 网页终端
CONFIG_PACKAGE_luci-app-nlbwmon=y         # 流量统计
CONFIG_PACKAGE_luci-app-sqm=y             # 智能队列（缓解 bufferbloat）
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-watchcat=y        # 断网自动重连/重启
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-package-manager=y # apk 时代的包管理界面（替代 luci-app-opkg）
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-app-cpufreq=y

#
# 额外添加的包（用户自定义，非核心默认）
#
CONFIG_PACKAGE_umdns=y                    # 本地 mDNS/zeroconf 支持（hostname.local 解析）
CONFIG_PACKAGE_kmod-mtd-rw=y              # MTD 分区临时写权限（用于 NAND/eMMC 恢复或刷写）
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_fwtool=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-webui=n
CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-ng=n
CONFIG_PACKAGE_default-settings-chn=y
