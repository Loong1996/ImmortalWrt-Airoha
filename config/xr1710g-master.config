#
# Brightspeed / Gemtek XR1710G —— master-airoha 线
#
# 这台只出网页救砖 U-Boot：原厂 BL2 与 U-Boot 锁着不动，由原厂 U-Boot 从
# chainloader 分区启动我们的 U-Boot，产物是 *-chainloader-slot.bin。
# 固件用 naoki66/ImmortalWrt-for-Gemtek-brightspeed —— 那边带着这台的 PCIe、
# RTL8261 等一整套内核修补，分区布局与这份 U-Boot 一致。
#
# 编 U-Boot 得走整套 OpenWrt 编译（槽位镜像挂在设备定义上），顺带编出来的固件
# 不发布，所以这里只选设备，不加任何软件包，省时间。
#
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_gemtek_xr1710g-ubi=y
CONFIG_ARCH_64BIT=y
CONFIG_aarch64=y
CONFIG_LINUX_6_18=y
